# ==============================================================================
# WorkTrack - Vercel Production & Local Environment Variables
# Copy this file to .env (for root / backend) and fill in your actual credentials.
# In Vercel, configure these under: Project Settings -> Environment Variables.
# ==============================================================================

# 1. Database Configuration (Neon PostgreSQL)
# Pooled connection string (used by application runtime and serverless functions):
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/worktrack?sslmode=require

# Direct connection string (used for schema migrations via drizzle-kit):
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/worktrack?sslmode=require

# 2. Authentication (JWT & Cookies)
# Strong cryptographic secret for signing JSON Web Tokens (min 32 characters):
JWT_SECRET=production_strong_jwt_secret_min_32_characters_random_string

# Token expiration duration (e.g. 7d, 24h):
JWT_EXPIRES_IN=7d

# Cookie SameSite attribute:
# Use 'lax' for single-domain deployment (recommended on Vercel), or 'none' for cross-domain:
COOKIE_SAME_SITE=lax

# 3. Application Origins & Environment
# Production URL of your deployed application (or localhost for local development):
CLIENT_URL=https://your-worktrack-project.vercel.app

# Environment Mode ('production' or 'development'):
NODE_ENV=production

# 4. Vercel Cron Security
# Secret bearer token used to authenticate automated Vercel Cron Job calls.
# Vercel automatically sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=production_cron_secret_min_32_characters_random_string

