# ==============================================================================
# WorkTrack Backend - Environment Variables
# ==============================================================================

# Neon PostgreSQL Pooled Connection (for serverless runtime & queries)
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/worktrack?sslmode=require

# Neon PostgreSQL Direct Connection (for drizzle migrations)
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/worktrack?sslmode=require

# JWT Configuration
JWT_SECRET=production_strong_jwt_secret_min_32_characters_random_string
JWT_EXPIRES_IN=7d

# Cookie SameSite ('lax' for same-origin Vercel deployment, 'none' for cross-domain)
COOKIE_SAME_SITE=lax

# Client Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Server Port (local dev only)
PORT=5000

# Environment Mode
NODE_ENV=development

# Vercel Cron Secret (for authenticating /api/cron/retention)
CRON_SECRET=production_cron_secret_min_32_characters_random_string
