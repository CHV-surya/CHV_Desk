# Neon PostgreSQL Pooled Connection (for application runtime)
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/worktrack?sslmode=require

# Neon PostgreSQL Direct Connection (for migrations)
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/worktrack?sslmode=require

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Client (Frontend) Origin for CORS & Cookies
CLIENT_URL=http://localhost:5173

# Server Port
PORT=5000

# Environment
NODE_ENV=development

